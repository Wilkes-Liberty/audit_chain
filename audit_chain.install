<?php

/**
 * @file
 * Install and schema functions for Audit Chain.
 *
 * Status-report findings live in AuditChainRequirements.
 */

declare(strict_types=1);

use Drupal\audit_chain\AuditChainLogger;
use Drupal\audit_chain\EvidenceExporter;
use Drupal\audit_chain\Hook\AuditChainRequirements;
use Drupal\audit_chain\ScheduledVerifier;
use Drupal\Core\Hook\Attribute\LegacyRequirementsHook;

/**
 * Implements hook_requirements() for Drupal 10.
 *
 * Drupal 10.6 has no hook_runtime_requirements(). On 11.2+ the OOP hook
 * runs; this bridge is skipped there so the same findings are not merged
 * twice. REQUIREMENT_* integers are gone in Drupal 12 — severity lives
 * on AuditChainRequirements::severity().
 */
#[LegacyRequirementsHook]
function audit_chain_requirements(string $phase): array {
  if ($phase !== 'runtime' || version_compare(\Drupal::VERSION, '11.2', '>=')) {
    return [];
  }
  return \Drupal::service(AuditChainRequirements::class)->runtime();
}

/**
 * Record which signing key hashed each row.
 */
function audit_chain_update_10001(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->fieldExists('audit_chain_log', 'key_id')) {
    return 'The key_id column already exists.';
  }

  // Deliberately left NULL for existing rows rather than backfilled from the
  // current setting. Which key hashed a historical row is not knowable from
  // configuration — the whole defect this column addresses is that the
  // configured key and the key actually used can differ — and writing today's
  // answer onto yesterday's rows would manufacture a fact. NULL reads as
  // "unrecorded", which is true, and verification handles it by trying every
  // key the site holds.
  $schema->addField('audit_chain_log', 'key_id', [
    'type' => 'varchar',
    'length' => 64,
    'not null' => FALSE,
    'description' => "Key entity ID whose material produced row_hash; '' when hashed unkeyed.",
  ]);

  return 'Added audit_chain_log.key_id. Existing rows are left unrecorded; verification tries every configured key.';
}

/**
 * Implements hook_schema().
 *
 * One append-only table. prev_hash/row_hash form the chain: row_hash covers
 * this row's content plus the previous row's hash, so any insertion, deletion
 * or edit breaks it and is detectable by AuditChainLogger::verify().
 *
 * The chain is global rather than per-channel. Interleaving is itself evidence
 * — a per-channel chain would let an attacker delete one channel's rows
 * without disturbing the others.
 */
function audit_chain_schema(): array {
  $schema['audit_chain_log'] = [
    'description' => 'Tamper-evident, hash-chained audit entries.',
    'fields' => [
      'id'           => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'channel'      => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'timestamp'    => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'uid'          => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'operation'    => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'entity_type'  => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'bundle'       => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'entity_id'    => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'entity_label' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'ip_address'   => ['type' => 'varchar', 'length' => 45, 'not null' => FALSE],
      'user_agent'   => ['type' => 'varchar', 'length' => 512, 'not null' => FALSE],
      'metadata'     => ['type' => 'text', 'size' => 'medium', 'not null' => FALSE],
      'prev_hash'    => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'row_hash'     => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      // Which Key entity's material produced row_hash; '' when hashed unkeyed.
      // Advisory only — it is not covered by the row hash (adding it to the
      // canonical payload would invalidate every row written before it
      // existed), so verification treats it as a hint about which key to try
      // first and never as proof of which key was used. See
      // AuditChainLogger::matchesAnyKey().
      'key_id'       => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      // Which encryption profile encrypted this row's metadata; '' when stored
      // as plaintext. Not covered by the row hash — the chain covers the
      // plaintext, so enabling or changing encryption does not invalidate
      // history. Recorded so a profile rotation is detectable before an
      // operator discovers old entries unreadable.
      'encryption_profile' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'channel'     => ['channel'],
      'timestamp'   => ['timestamp'],
      'uid'         => ['uid'],
      'operation'   => ['operation'],
      'entity_type' => ['entity_type'],
      'row_hash'    => ['row_hash'],
      'encryption_profile' => ['encryption_profile'],
    ],
  ];

  $schema['audit_chain_mutex'] = [
    'description' => 'Singleton row lock serialising appends until commit.',
    'fields' => [
      'id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Singleton id; always 1.',
      ],
      'locked' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 1,
        'description' => 'Dummy payload; UPDATE takes the SQLite write lock.',
      ],
    ],
    'primary key' => ['id'],
  ];

  $schema['audit_chain_recovery'] = [
    'description' => 'Append-only signed recovery manifests; historical verdicts remain unchanged.',
    'fields' => [
      'segment_id' => ['type' => 'varchar', 'length' => 36, 'not null' => TRUE],
      'manifest' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
      'key_id' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'mac' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
    ],
    'primary key' => ['segment_id'],
  ];

  $schema['audit_chain_checkpoint'] = [
    'description' => 'Versioned archival checkpoints over closed global chain windows.',
    'fields' => [
      'digest' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'contract_version' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'from_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'through_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'row_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'manifest' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
    ],
    'primary key' => ['digest'],
    'indexes' => [
      'window' => ['from_id', 'through_id'],
      'created' => ['created'],
    ],
  ];

  $schema['audit_chain_witness_receipt'] = [
    'description' => 'Opaque receipts for external witnesses of checkpoint digests.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
      'checkpoint_digest' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'backend_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'status' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE],
      'submitted' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'updated' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'opaque_token' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'checkpoint_digest' => ['checkpoint_digest'],
      'backend_status' => ['backend_id', 'status'],
    ],
  ];

  return $schema;
}

/**
 * Adds recovery-record storage without modifying any historical audit row.
 */
function audit_chain_update_10004(): string {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('audit_chain_recovery')) {
    $definition = audit_chain_schema();
    $schema->createTable('audit_chain_recovery', $definition['audit_chain_recovery']);
  }
  return 'Added signed recovery-record storage. No successor was activated and no audit history was changed.';
}

/**
 * Adds archival checkpoint and witness-receipt storage without changing rows.
 */
function audit_chain_update_10005(): string {
  $schema = \Drupal::database()->schema();
  $definition = audit_chain_schema();
  foreach (['audit_chain_checkpoint', 'audit_chain_witness_receipt'] as $table) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $definition[$table]);
    }
  }
  return 'Added archival checkpoint and witness-receipt storage. No audit rows or retention behavior changed.';
}

/**
 * Adds witness client settings without contacting a witness or changing rows.
 */
function audit_chain_update_10006(): string {
  $config = \Drupal::configFactory()->getEditable('audit_chain.settings');
  $defaults = [
    'witness_opentimestamps' => [
      'calendars' => [
        'https://a.pool.opentimestamps.org',
        'https://b.pool.opentimestamps.org',
      ],
      'upgrade_allowlist' => [
        'https://a.pool.opentimestamps.org',
        'https://b.pool.opentimestamps.org',
        'https://alice.btc.calendar.opentimestamps.org',
        'https://bob.btc.calendar.opentimestamps.org',
        'https://finney.calendar.eternitywall.com',
      ],
      'header_url' => 'https://blockstream.info/api',
      'min_depth' => 6,
    ],
    'witness_xrpl' => [
      'relay_url' => '',
      'read_url' => '',
      'network' => '',
      'sink_address' => '',
      'witness_account' => '',
    ],
  ];
  $changed = FALSE;
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
      $changed = TRUE;
    }
  }
  if ($changed) {
    $config->save();
  }
  return 'Added inactive witness client settings. No witness was contacted and no audit row changed.';
}

/**
 * Adds empty RFC 3161 witness settings without contacting a TSA.
 */
function audit_chain_update_10007(): string {
  $config = \Drupal::configFactory()->getEditable('audit_chain.settings');
  if ($config->get('witness_rfc3161') === NULL) {
    $config->set('witness_rfc3161', [
      'tsa_url' => '',
      'policy_oid' => '',
      'trust_anchors' => '',
      'ocsp_override' => '',
      'credential_key' => '',
    ]);
    $config->save();
  }
  return 'Added empty RFC 3161 witness settings. No TSA was contacted and no audit row changed.';
}

/**
 * Default stream_exclude_dblog off so stream_enabled keeps the 1.12.2 sink.
 *
 * Rollback is a no-op: this only writes FALSE when the key is missing.
 * Reverting the schema version leaves the key in config, which 1.13.0
 * ignores. Deleting the key after a code rollback is unnecessary.
 */
function audit_chain_update_10008(): string {
  $config = \Drupal::configFactory()->getEditable('audit_chain.settings');
  if ($config->get('stream_exclude_dblog') === NULL) {
    $config->set('stream_exclude_dblog', FALSE);
    $config->save();
  }
  return 'Set stream_exclude_dblog to FALSE when missing. Successful appends keep using logger.channel.audit_chain. Rolling this update back is a no-op.';
}

/**
 * Implements hook_install().
 */
function audit_chain_install(): void {
  \Drupal::database()->insert('audit_chain_mutex')->fields([
    'id' => 1,
    'locked' => 1,
  ])->execute();
}

/**
 * Implements hook_uninstall().
 *
 * Schema tables drop automatically. Module-owned state does not. A leftover
 * prefix seal makes the next install's empty-chain verify() return
 * seal_broken.
 */
function audit_chain_uninstall(): void {
  $keys = [
    AuditChainLogger::STATE_SEAL,
    ScheduledVerifier::STATE_KEY,
    'audit_chain.retention_refused',
  ];
  foreach (array_keys(\Drupal::keyValue('state')->getAll()) as $name) {
    if (str_starts_with((string) $name, EvidenceExporter::CHECKPOINT_PREFIX)) {
      $keys[] = $name;
    }
  }
  \Drupal::state()->deleteMultiple($keys);
}

/**
 * Record which encryption profile encrypted each row's metadata.
 */
function audit_chain_update_10002(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->fieldExists('audit_chain_log', 'encryption_profile')) {
    return 'The encryption_profile column already exists.';
  }

  // Left NULL for existing rows rather than backfilled from the current
  // setting, for the same reason as key_id: which profile encrypted a
  // historical row is not knowable from configuration, and the whole point of
  // the column is that the configured profile and the one actually used can
  // differ. NULL reads as "unrecorded", which is true.
  $schema->addField('audit_chain_log', 'encryption_profile', [
    'type' => 'varchar',
    'length' => 64,
    'not null' => FALSE,
    'description' => "Encryption profile that encrypted metadata; '' when plaintext.",
  ], ['indexes' => ['encryption_profile' => ['encryption_profile']]]);

  return 'Added audit_chain_log.encryption_profile. Existing rows are left unrecorded.';
}

/**
 * Add the append mutex without changing audit history.
 */
function audit_chain_update_10003(): string {
  $database = \Drupal::database();
  $schema = $database->schema();
  if (!$schema->tableExists('audit_chain_mutex')) {
    $schema->createTable('audit_chain_mutex', audit_chain_schema()['audit_chain_mutex']);
  }
  $database->merge('audit_chain_mutex')
    ->key('id', 1)
    ->fields(['locked' => 1])
    ->execute();
  return 'Added append serialization. Existing audit rows and seals are unchanged.';
}
