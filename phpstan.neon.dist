# PHPStan configuration for Audit Chain.
# Run on Drupal CI via commit-code-check.sh; phpstan-drupal is provided there.
includes:
  - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
  level: 6
  # Inline @phpstan-ignore comments may not match across phpstan versions.
  reportUnmatchedIgnoredErrors: false
  paths:
    - .
  excludePaths:
    # Optional (?): there is no vendor/ under the module in DrupalCI, where the
    # module is analysed in place; the marker stops PHPStan erroring when absent.
    - vendor (?)
  fileExtensions:
    - php
    - module
    - inc
    - install
  ignoreErrors:
    # new static() is a Drupal best practice for plugins and services.
    - "#^Unsafe usage of new static#"
    - identifier: missingType.iterableValue
    - identifier: missingType.generics
    # The suite uses PHPUnit attributes (#[Group], #[CoversClass], ...). This
    # module supports Drupal 10.6, which ships PHPUnit 9 — a version with no
    # PHPUnit\Framework\Attributes namespace — so the previous-major job reports
    # every attribute as a missing class. PHP attributes are inert unless
    # reflected on, so the tests themselves pass there; this is a cross-version
    # static-analysis artifact. Reassess when the floor rises above Drupal 10.
    - "#Attribute class PHPUnit.*Attributes.* does not exist#"
