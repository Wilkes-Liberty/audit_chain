<?php

/**
 * @file
 * Install and schema functions for Audit Chain.
 */

/**
 * Implements hook_requirements().
 *
 * Reports the one condition that otherwise has no signal anywhere: a signing
 * key that is configured but will not resolve. The chain keeps working when
 * that happens — it falls back to unkeyed SHA-256 — so nothing errors, nothing
 * is missing, and the site goes on believing its audit trail is signed. A real
 * deployment ran that way for 1,997 of 2,002 rows before anyone noticed, and
 * noticed only because verification then reported the whole chain as tampered.
 *
 * Reported at ERROR rather than WARNING: the module's single headline claim is
 * that forging a repair requires the key. While this condition holds, it does
 * not.
 */
function audit_chain_requirements(string $phase): array {
  $requirements = [];
  if ($phase !== 'runtime') {
    return $requirements;
  }

  // Runs on every path, including the two early returns below: a retired
  // encryption profile is independent of whether the chain is signed, and
  // hanging it off the key check would hide it on exactly the sites that
  // configured signing correctly.
  _audit_chain_requirements_encryption($requirements);

  $keyId = (string) (\Drupal::config('audit_chain.settings')->get('hash_key') ?? '');
  if ($keyId === '') {
    // Unkeyed by choice. Documented behaviour, not a fault.
    return $requirements;
  }

  $key = \Drupal::service('key.repository')->getKey($keyId);
  if ($key !== NULL && (string) $key->getKeyValue() !== '') {
    return $requirements;
  }

  $requirements['audit_chain_hash_key'] = [
    'title' => t('Audit Chain: signing key unresolvable'),
    'value' => t("Key '@key' is configured but resolves to nothing", ['@key' => $keyId]),
    'severity' => REQUIREMENT_ERROR,
    'description' => t("Every entry written while this holds is hashed with unkeyed SHA-256, so anyone with database access can edit a row and recompute the chain over it. Entries already written this way cannot be signed retrospectively — fix the Key entity, then run <code>drush audit-chain:verify</code>, which reports rows written unkeyed separately from tampering."),
  ];

  return $requirements;
}

/**
 * Reports entries encrypted under a profile the site no longer uses.
 *
 * Rotating an encryption profile is ordinary key hygiene — a compliance regime
 * may require it on a schedule — and it silently orphans every row written
 * under the previous profile. Nothing looks broken: the rows are still there
 * and the hash chain still verifies, because the chain covers the plaintext and
 * not the ciphertext. The loss only surfaces when someone opens an old entry,
 * which is exactly the moment an audit trail is supposed to work.
 *
 * Reported at WARNING rather than ERROR: the entries are intact and the chain's
 * integrity guarantee is unaffected. What is lost is readability of their
 * metadata, and there is no re-encrypt path yet (see the project issue queue),
 * so this converts a silent trap into a visible one rather than implying a fix
 * exists.
 *
 * @param array $requirements
 *   The requirements array, added to by reference.
 */
function _audit_chain_requirements_encryption(array &$requirements): void {
  $database = \Drupal::database();
  if (!$database->schema()->tableExists('audit_chain_log')
    || !$database->schema()->fieldExists('audit_chain_log', 'encryption_profile')) {
    // Mid-install, mid-uninstall, or before update 10002. A status check must
    // never itself crash.
    return;
  }

  $configured = (string) (\Drupal::config('audit_chain.settings')->get('encryption_profile') ?? '');

  // Existence, not a count: the index makes this cheap on a large table, and
  // the operator needs to know *that* it happened, not how many times.
  $query = $database->select('audit_chain_log', 'l');
  $query->fields('l', ['encryption_profile']);
  $query->isNotNull('l.encryption_profile');
  $query->condition('l.encryption_profile', '', '<>');
  $query->condition('l.encryption_profile', $configured, '<>');
  $stale = $query->range(0, 1)->execute()->fetchField();

  if ($stale === FALSE || $stale === NULL) {
    return;
  }

  $requirements['audit_chain_encryption_rotated'] = [
    'title' => t('Audit Chain: entries encrypted under a retired profile'),
    'value' => $configured === ''
      ? t("Rows were encrypted with '@old'; encryption is now off", ['@old' => $stale])
      : t("Rows were encrypted with '@old'; the configured profile is '@new'", ['@old' => $stale, '@new' => $configured]),
    'severity' => REQUIREMENT_WARNING,
    'description' => t("The metadata on those entries cannot be decrypted with the profile configured now, so it reads as empty. The entries themselves are intact and the chain still verifies — the chain covers the plaintext, not the ciphertext — but their context is unreadable until the old profile is restored. There is no re-encrypt command yet; if you still hold the previous profile, restoring it makes those entries readable again."),
  ];
}

/**
 * Record which signing key hashed each row.
 */
function audit_chain_update_10001(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->fieldExists('audit_chain_log', 'key_id')) {
    return 'The key_id column already exists.';
  }

  // Deliberately left NULL for existing rows rather than backfilled from the
  // current setting. Which key hashed a historical row is not knowable from
  // configuration — the whole defect this column addresses is that the
  // configured key and the key actually used can differ — and writing today's
  // answer onto yesterday's rows would manufacture a fact. NULL reads as
  // "unrecorded", which is true, and verification handles it by trying every
  // key the site holds.
  $schema->addField('audit_chain_log', 'key_id', [
    'type' => 'varchar',
    'length' => 64,
    'not null' => FALSE,
    'description' => "Key entity ID whose material produced row_hash; '' when hashed unkeyed.",
  ]);

  return 'Added audit_chain_log.key_id. Existing rows are left unrecorded; verification tries every configured key.';
}

/**
 * Implements hook_schema().
 *
 * One append-only table. prev_hash/row_hash form the chain: row_hash covers
 * this row's content plus the previous row's hash, so any insertion, deletion
 * or edit breaks it and is detectable by AuditChainLogger::verify().
 *
 * The chain is global rather than per-channel. Interleaving is itself evidence
 * — a per-channel chain would let an attacker delete one channel's rows
 * without disturbing the others.
 */
function audit_chain_schema(): array {
  $schema['audit_chain_log'] = [
    'description' => 'Tamper-evident, hash-chained audit entries.',
    'fields' => [
      'id'           => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'channel'      => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'timestamp'    => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'uid'          => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'operation'    => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'entity_type'  => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'bundle'       => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'entity_id'    => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'entity_label' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'ip_address'   => ['type' => 'varchar', 'length' => 45, 'not null' => FALSE],
      'user_agent'   => ['type' => 'varchar', 'length' => 512, 'not null' => FALSE],
      'metadata'     => ['type' => 'text', 'size' => 'medium', 'not null' => FALSE],
      'prev_hash'    => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'row_hash'     => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      // Which Key entity's material produced row_hash; '' when hashed unkeyed.
      // Advisory only — it is not covered by the row hash (adding it to the
      // canonical payload would invalidate every row written before it
      // existed), so verification treats it as a hint about which key to try
      // first and never as proof of which key was used. See
      // AuditChainLogger::matchesAnyKey().
      'key_id'       => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      // Which encryption profile encrypted this row's metadata; '' when stored
      // as plaintext. Not covered by the row hash — the chain covers the
      // plaintext, so enabling or changing encryption does not invalidate
      // history. Recorded so a profile rotation is detectable before an
      // operator discovers old entries unreadable.
      'encryption_profile' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
    ],
    'primary key' => ['id'],
    // Back the usual filters (channel, time window, actor, operation, type)
    // and the verifier's hash lookups.
    'indexes' => [
      'channel'     => ['channel'],
      'timestamp'   => ['timestamp'],
      'uid'         => ['uid'],
      'operation'   => ['operation'],
      'entity_type' => ['entity_type'],
      'row_hash'    => ['row_hash'],
      // Backs the status-report check for rows written under a retired profile.
      'encryption_profile' => ['encryption_profile'],
    ],
  ];

  return $schema;
}

/**
 * Record which encryption profile encrypted each row's metadata.
 */
function audit_chain_update_10002(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->fieldExists('audit_chain_log', 'encryption_profile')) {
    return 'The encryption_profile column already exists.';
  }

  // Left NULL for existing rows rather than backfilled from the current
  // setting, for the same reason as key_id: which profile encrypted a
  // historical row is not knowable from configuration, and the whole point of
  // the column is that the configured profile and the one actually used can
  // differ. NULL reads as "unrecorded", which is true.
  $schema->addField('audit_chain_log', 'encryption_profile', [
    'type' => 'varchar',
    'length' => 64,
    'not null' => FALSE,
    'description' => "Encryption profile that encrypted metadata; '' when plaintext.",
  ], ['indexes' => ['encryption_profile' => ['encryption_profile']]]);

  return 'Added audit_chain_log.encryption_profile. Existing rows are left unrecorded.';
}
