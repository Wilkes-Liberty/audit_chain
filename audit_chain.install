<?php

/**
 * @file
 * Install and schema functions for Audit Chain.
 */

use Drupal\audit_chain\AuditChainLogger;
use Drupal\audit_chain\EvidenceExporter;
use Drupal\audit_chain\ScheduledVerificationIntegrity;
use Drupal\audit_chain\ScheduledVerifier;

/**
 * Implements hook_requirements().
 *
 * Reports the one condition that otherwise has no signal anywhere: a signing
 * key that is configured but will not resolve. The chain keeps working when
 * that happens — it falls back to unkeyed SHA-256 — so nothing errors, nothing
 * is missing, and the site goes on believing its audit trail is signed.
 *
 * Reported at ERROR rather than WARNING: the module's single headline claim is
 * that forging a repair requires the key. While this condition holds, it does
 * not.
 */
function audit_chain_requirements(string $phase): array {
  $requirements = [];
  if ($phase !== 'runtime') {
    return $requirements;
  }

  // Runs on every path, including the two early returns below: a retired
  // encryption profile is independent of whether the chain is signed, and
  // hanging it off the key check would hide it on exactly the sites that
  // configured signing correctly.
  if (\Drupal::state()->get('audit_chain.retention_refused', FALSE)) {
    $requirements['audit_chain_retention'] = [
      'title' => t('Audit Chain: retention requires review'),
      'value' => t('Automatic deletion refused; audit records retained'),
      'severity' => REQUIREMENT_WARNING,
      'description' => t('A consumer requested deletion of expired audit records. Channels share one chain, so deleting those records would invalidate retained evidence. Review retention requirements and storage capacity. This warning does not mean the chain verifies; check the separate verification result.'),
    ];
  }

  _audit_chain_requirements_encryption($requirements);
  _audit_chain_requirements_seal($requirements);
  _audit_chain_requirements_scheduled_verification($requirements);

  /** @var \Drupal\audit_chain\AuditChainLoggerInterface $logger */
  $logger = \Drupal::service('audit_chain.logger');
  $status = $logger->signingStatus();
  if ($status['key_id'] === '') {
    // Unkeyed by choice. Documented behaviour, not a fault.
    return $requirements;
  }

  if ($status['keyed']) {
    return $requirements;
  }

  $requirements['audit_chain_hash_key'] = [
    'title' => t('Audit Chain: signing key unresolvable'),
    'value' => t("Key '@key' is configured but resolves to nothing", ['@key' => $status['key_id']]),
    'severity' => REQUIREMENT_ERROR,
    'description' => t("Every entry written while this holds is hashed with unkeyed SHA-256, so anyone with database access can edit a row and recompute the chain over it. Entries already written this way cannot be signed retrospectively — fix the Key entity, then run <code>drush audit-chain:verify</code>, which reports rows written unkeyed separately from tampering."),
  ];

  return $requirements;
}

/**
 * Reports an active prefix seal (historical, not a live-chain failure).
 *
 * @param array $requirements
 *   The requirements array, added to by reference.
 */
function _audit_chain_requirements_seal(array &$requirements): void {
  /** @var \Drupal\audit_chain\AuditChainLoggerInterface $logger */
  $logger = \Drupal::service('audit_chain.logger');
  $seal = $logger->getSeal();
  if ($seal === NULL) {
    return;
  }
  $requirements['audit_chain_prefix_seal'] = [
    'title' => t('Audit Chain: historical prefix sealed'),
    'value' => t('Sealed through row id @id (@count chained hashes)', [
      '@id' => $seal['sealed_through_id'],
      '@count' => $seal['row_count'],
    ]),
    'severity' => REQUIREMENT_WARNING,
    'description' => t('A genesis seal freezes an unverifiable prefix so it is not re-chained. Content before that id is not re-checked; only that stored hashes are unchanged. Post-seal rows are still fully verified. Reason recorded: @reason. Run <code>drush audit-chain:verify</code> for the live verdict.', [
      '@reason' => $seal['reason'],
    ]),
  ];
}

/**
 * Reports entries encrypted under a profile the site no longer uses.
 *
 * @param array $requirements
 *   The requirements array, added to by reference.
 */
function _audit_chain_requirements_encryption(array &$requirements): void {
  $database = \Drupal::database();
  if (!$database->schema()->tableExists('audit_chain_log')
    || !$database->schema()->fieldExists('audit_chain_log', 'encryption_profile')) {
    // Mid-install, mid-uninstall, or before update 10002. A status check must
    // never itself crash.
    return;
  }

  $configured = (string) (\Drupal::config('audit_chain.settings')->get('encryption_profile') ?? '');

  // Existence, not a count: the index makes this cheap on a large table, and
  // the operator needs to know *that* it happened, not how many times.
  $query = $database->select('audit_chain_log', 'l');
  $query->fields('l', ['encryption_profile']);
  $query->isNotNull('l.encryption_profile');
  $query->condition('l.encryption_profile', '', '<>');
  $query->condition('l.encryption_profile', $configured, '<>');
  $stale = $query->range(0, 1)->execute()->fetchField();

  if ($stale === FALSE || $stale === NULL) {
    return;
  }

  $requirements['audit_chain_encryption_rotated'] = [
    'title' => t('Audit Chain: entries encrypted under a retired profile'),
    'value' => $configured === ''
      ? t("Rows were encrypted with '@old'; encryption is now off", ['@old' => $stale])
      : t("Rows were encrypted with '@old'; the configured profile is '@new'", ['@old' => $stale, '@new' => $configured]),
    'severity' => REQUIREMENT_WARNING,
    'description' => t("The metadata on those entries cannot be decrypted with the profile configured now. The entries themselves are intact and the chain still verifies when the old profile entity is still loadable (each row records which profile produced its bytes). Run <code>drush audit-chain:reencrypt --from=PROFILE --to=PROFILE</code> to rewrite ciphertext to the current profile without touching hashes. Keep the previous EncryptionProfile until that finishes."),
  ];
}

/**
 * Record which signing key hashed each row.
 */
function audit_chain_update_10001(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->fieldExists('audit_chain_log', 'key_id')) {
    return 'The key_id column already exists.';
  }

  // Deliberately left NULL for existing rows rather than backfilled from the
  // current setting. Which key hashed a historical row is not knowable from
  // configuration — the whole defect this column addresses is that the
  // configured key and the key actually used can differ — and writing today's
  // answer onto yesterday's rows would manufacture a fact. NULL reads as
  // "unrecorded", which is true, and verification handles it by trying every
  // key the site holds.
  $schema->addField('audit_chain_log', 'key_id', [
    'type' => 'varchar',
    'length' => 64,
    'not null' => FALSE,
    'description' => "Key entity ID whose material produced row_hash; '' when hashed unkeyed.",
  ]);

  return 'Added audit_chain_log.key_id. Existing rows are left unrecorded; verification tries every configured key.';
}

/**
 * Implements hook_schema().
 *
 * One append-only table. prev_hash/row_hash form the chain: row_hash covers
 * this row's content plus the previous row's hash, so any insertion, deletion
 * or edit breaks it and is detectable by AuditChainLogger::verify().
 *
 * The chain is global rather than per-channel. Interleaving is itself evidence
 * — a per-channel chain would let an attacker delete one channel's rows
 * without disturbing the others.
 */
function audit_chain_schema(): array {
  $schema['audit_chain_log'] = [
    'description' => 'Tamper-evident, hash-chained audit entries.',
    'fields' => [
      'id'           => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'channel'      => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'timestamp'    => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'uid'          => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'operation'    => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'entity_type'  => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'bundle'       => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'entity_id'    => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'entity_label' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'ip_address'   => ['type' => 'varchar', 'length' => 45, 'not null' => FALSE],
      'user_agent'   => ['type' => 'varchar', 'length' => 512, 'not null' => FALSE],
      'metadata'     => ['type' => 'text', 'size' => 'medium', 'not null' => FALSE],
      'prev_hash'    => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'row_hash'     => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      // Which Key entity's material produced row_hash; '' when hashed unkeyed.
      // Advisory only — it is not covered by the row hash (adding it to the
      // canonical payload would invalidate every row written before it
      // existed), so verification treats it as a hint about which key to try
      // first and never as proof of which key was used. See
      // AuditChainLogger::matchesAnyKey().
      'key_id'       => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      // Which encryption profile encrypted this row's metadata; '' when stored
      // as plaintext. Not covered by the row hash — the chain covers the
      // plaintext, so enabling or changing encryption does not invalidate
      // history. Recorded so a profile rotation is detectable before an
      // operator discovers old entries unreadable.
      'encryption_profile' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'channel'     => ['channel'],
      'timestamp'   => ['timestamp'],
      'uid'         => ['uid'],
      'operation'   => ['operation'],
      'entity_type' => ['entity_type'],
      'row_hash'    => ['row_hash'],
      'encryption_profile' => ['encryption_profile'],
    ],
  ];

  $schema['audit_chain_mutex'] = [
    'description' => 'Singleton row lock serialising appends until commit.',
    'fields' => [
      'id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Singleton id; always 1.',
      ],
      'locked' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 1,
        'description' => 'Dummy payload; UPDATE takes the SQLite write lock.',
      ],
    ],
    'primary key' => ['id'],
  ];

  $schema['audit_chain_recovery'] = [
    'description' => 'Append-only signed recovery manifests; historical verdicts remain unchanged.',
    'fields' => [
      'segment_id' => ['type' => 'varchar', 'length' => 36, 'not null' => TRUE],
      'manifest' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
      'key_id' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'mac' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
    ],
    'primary key' => ['segment_id'],
  ];

  $schema['audit_chain_checkpoint'] = [
    'description' => 'Versioned archival checkpoints over closed global chain windows.',
    'fields' => [
      'digest' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'contract_version' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'from_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'through_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'row_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'manifest' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
    ],
    'primary key' => ['digest'],
    'indexes' => [
      'window' => ['from_id', 'through_id'],
      'created' => ['created'],
    ],
  ];

  $schema['audit_chain_witness_receipt'] = [
    'description' => 'Opaque receipts for external witnesses of checkpoint digests.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
      'checkpoint_digest' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'backend_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'status' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE],
      'submitted' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'updated' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'opaque_token' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'checkpoint_digest' => ['checkpoint_digest'],
      'backend_status' => ['backend_id', 'status'],
    ],
  ];

  return $schema;
}

/**
 * Adds recovery-record storage without modifying any historical audit row.
 */
function audit_chain_update_10004(): string {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('audit_chain_recovery')) {
    $definition = audit_chain_schema();
    $schema->createTable('audit_chain_recovery', $definition['audit_chain_recovery']);
  }
  return 'Added signed recovery-record storage. No successor was activated and no audit history was changed.';
}

/**
 * Adds archival checkpoint and witness-receipt storage without changing rows.
 */
function audit_chain_update_10005(): string {
  $schema = \Drupal::database()->schema();
  $definition = audit_chain_schema();
  foreach (['audit_chain_checkpoint', 'audit_chain_witness_receipt'] as $table) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $definition[$table]);
    }
  }
  return 'Added archival checkpoint and witness-receipt storage. No audit rows or retention behavior changed.';
}

/**
 * Adds witness client settings without contacting a witness or changing rows.
 */
function audit_chain_update_10006(): string {
  $config = \Drupal::configFactory()->getEditable('audit_chain.settings');
  $defaults = [
    'witness_opentimestamps' => [
      'calendars' => [
        'https://a.pool.opentimestamps.org',
        'https://b.pool.opentimestamps.org',
      ],
      'upgrade_allowlist' => [
        'https://a.pool.opentimestamps.org',
        'https://b.pool.opentimestamps.org',
        'https://alice.btc.calendar.opentimestamps.org',
        'https://bob.btc.calendar.opentimestamps.org',
        'https://finney.calendar.eternitywall.com',
      ],
      'header_url' => 'https://blockstream.info/api',
      'min_depth' => 6,
    ],
    'witness_xrpl' => [
      'relay_url' => '',
      'read_url' => '',
      'network' => '',
      'sink_address' => '',
      'witness_account' => '',
    ],
  ];
  $changed = FALSE;
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
      $changed = TRUE;
    }
  }
  if ($changed) {
    $config->save();
  }
  return 'Added inactive witness client settings. No witness was contacted and no audit row changed.';
}

/**
 * Implements hook_install().
 */
function audit_chain_install(): void {
  \Drupal::database()->insert('audit_chain_mutex')->fields([
    'id' => 1,
    'locked' => 1,
  ])->execute();
}

/**
 * Implements hook_uninstall().
 *
 * Schema tables drop automatically. Module-owned state does not. A leftover
 * prefix seal makes the next install's empty-chain verify() return
 * seal_broken.
 */
function audit_chain_uninstall(): void {
  $keys = [
    AuditChainLogger::STATE_SEAL,
    ScheduledVerifier::STATE_KEY,
    'audit_chain.retention_refused',
  ];
  foreach (array_keys(\Drupal::keyValue('state')->getAll()) as $name) {
    if (str_starts_with((string) $name, EvidenceExporter::CHECKPOINT_PREFIX)) {
      $keys[] = $name;
    }
  }
  \Drupal::state()->deleteMultiple($keys);
}

/**
 * Record which encryption profile encrypted each row's metadata.
 */
function audit_chain_update_10002(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->fieldExists('audit_chain_log', 'encryption_profile')) {
    return 'The encryption_profile column already exists.';
  }

  // Left NULL for existing rows rather than backfilled from the current
  // setting, for the same reason as key_id: which profile encrypted a
  // historical row is not knowable from configuration, and the whole point of
  // the column is that the configured profile and the one actually used can
  // differ. NULL reads as "unrecorded", which is true.
  $schema->addField('audit_chain_log', 'encryption_profile', [
    'type' => 'varchar',
    'length' => 64,
    'not null' => FALSE,
    'description' => "Encryption profile that encrypted metadata; '' when plaintext.",
  ], ['indexes' => ['encryption_profile' => ['encryption_profile']]]);

  return 'Added audit_chain_log.encryption_profile. Existing rows are left unrecorded.';
}

/**
 * Reports the scheduled-verification health (d.o #3616535).
 *
 * Classification is ScheduledVerificationIntegrity::classify(); this function
 * maps those states onto requirement copy. The assurance-profile-without-
 * schedule warning is presentation: the classifier only sees interval and run.
 *
 * An integrity or assurance failure is an ERROR. A leading unsigned prefix
 * with a verifying signed successor is a documented WARNING: those rows stay
 * in the log and are not re-signed. A disclosed historical fork whose
 * successor segment verifies is a documented WARNING: whole-history
 * verification stays unsuccessful and rows are not rewritten. A missing
 * successor or segment_ok=false stays an ERROR. A foreign seal is a WARNING:
 * it remains unverified, but its copied prefix hashes have not changed. A
 * schedule that has gone quiet (no run within twice its interval) is a
 * WARNING — silence is not health. A confirmed witness the live chain no
 * longer contains is an ERROR (`chain_rewound`): a database restore can leave
 * the hashes consistent. A witness that cannot be read is a WARNING and does
 * not by itself fail the hash-chain result. Requiring keyed verification
 * while never scheduling it is also a WARNING: the assurance profile is only
 * as strong as its cadence.
 *
 * @param array $requirements
 *   The requirements array, added to by reference.
 */
function _audit_chain_requirements_scheduled_verification(array &$requirements): void {
  $settings = \Drupal::config('audit_chain.settings');
  $interval = (int) $settings->get('verify_interval');
  $require_keyed = (bool) $settings->get('verify_require_keyed');
  $run = \Drupal::state()->get(ScheduledVerifier::STATE_KEY);
  $classified = ScheduledVerificationIntegrity::classify(
    $run,
    $interval,
    \Drupal::time()->getRequestTime(),
  );
  $severity = match ($classified['status']) {
    'ok' => REQUIREMENT_OK,
    'crit' => REQUIREMENT_ERROR,
    'warn' => REQUIREMENT_WARNING,
    default => throw new \InvalidArgumentException('Unknown integrity status: ' . $classified['status']),
  };
  $run_reason = is_array($run) ? (string) ($run['reason'] ?? '') : '';
  $title = t('Audit Chain: scheduled verification');
  // Only states that show a last-run time need date.formatter; other
  // hook_requirements callers may not have system date formats installed.
  $when = in_array($classified['reason'], [
    'seal_foreign',
    'unsigned_prefix',
    'historical_exception',
    'failed',
    'overdue',
    'passing',
    'chain_rewound',
    'witness_unreachable',
  ], TRUE)
    ? \Drupal::service('date.formatter')->format((int) ($classified['time'] ?? 0))
    : NULL;

  $requirement = match ($classified['reason']) {
    'disabled' => $require_keyed ? [
      'title' => $title,
      'value' => t('Assurance profile enabled, but no verification schedule'),
      'severity' => $severity,
      'description' => t('verify_require_keyed is on while verify_interval is 0: keyed verification is required but never runs. Set a verification interval so integrity is proven on a cadence rather than on demand.'),
    ] : NULL,
    'pending' => [
      'title' => $title,
      'value' => t('Enabled, but no run recorded yet'),
      'severity' => $severity,
      'description' => t('The schedule is configured but cron has not executed a verification yet. Run cron, then re-check this report.'),
    ],
    'seal_foreign' => [
      'title' => $title,
      'value' => t('FOREIGN SEAL — unverified copy (last run @time)', [
        '@time' => $when,
      ]),
      'severity' => $severity,
      'description' => t('The sealed prefix hashes are unchanged, but this environment cannot authenticate the copied seal with a current or retired signing key. No prefix-hash change was detected. Verification remains fail-closed and evidence export stays blocked. Verify on the source environment, or make its signing key available as a retired key only if your key-separation policy permits.'),
    ],
    'unsigned_prefix' => [
      'title' => $title,
      'value' => t('Documented unsigned prefix (last run @time)', [
        '@time' => $when,
      ]),
      'severity' => $severity,
      'description' => t('A leading run of entries was hashed with unkeyed SHA-256. Those rows stay in the log. They are not cryptographically verifiable, and they are not re-signed or deleted. The signed rows after that prefix are the authoritative chain. An edited signed row, a missing signing key, or an unsigned row after the signed successor is still an error.'),
    ],
    'historical_exception' => _audit_chain_requirements_historical_exception(
      $title,
      $severity,
      $when,
      is_array($run) ? $run : [],
    ),
    'failed' => [
      'title' => $title,
      'value' => t('FAILED — @reason (last run @time)', [
        '@reason' => $run_reason,
        '@time' => $when,
      ]),
      'severity' => $severity,
      'description' => t('The last scheduled verification did not pass. The chain was not modified by the check; investigate the reported reason with <code>drush audit-chain:verify</code> before trusting new entries.'),
    ],
    'chain_rewound' => [
      'title' => $title,
      'value' => t('CHAIN REWOUND (last run @time)', [
        '@time' => $when,
      ]),
      'severity' => $severity,
      'description' => t('A confirmed witness is no longer present in the live chain. A database restore can rewind the chain without breaking its hashes. The chain was not modified by the check. Investigate before trusting new entries.'),
    ],
    'witness_unreachable' => [
      'title' => $title,
      'value' => t('Rewind check unavailable (last run @time)', [
        '@time' => $when,
      ]),
      'severity' => $severity,
      'description' => t('The configured witness could not be read, so this run does not show whether a database restore rewound the chain. The hash-chain result is recorded separately.'),
    ],
    'overdue' => [
      'title' => $title,
      'value' => t('Overdue — last successful run @time', [
        '@time' => $when,
      ]),
      'severity' => $severity,
      'description' => t('No verification has run within twice the configured interval. Confirm cron is executing; an unverified chain is an unproven one.'),
    ],
    'passing' => [
      'title' => $title,
      'value' => t('Passing — last run @time', [
        '@time' => $when,
      ]),
      'severity' => $severity,
    ],
    default => throw new \InvalidArgumentException('Unknown integrity reason: ' . $classified['reason']),
  };

  if ($requirement !== NULL) {
    $requirements['audit_chain_scheduled_verification'] = $requirement;
  }
}

/**
 * Builds the documented historical-exception status-report row.
 *
 * @param \Drupal\Core\StringTranslation\TranslatableMarkup $title
 *   Shared scheduled-verification title.
 * @param int $severity
 *   Classified severity.
 * @param string|\Drupal\Core\StringTranslation\TranslatableMarkup|null $when
 *   Formatted last-run time.
 * @param array $run
 *   The stored scheduled-verification run.
 *
 * @return array
 *   A hook_requirements row.
 */
function _audit_chain_requirements_historical_exception(mixed $title, int $severity, mixed $when, array $run): array {
  $successor = is_array($run['successor'] ?? NULL) ? $run['successor'] : [];
  $verdict = is_array($run['verdict'] ?? NULL) ? $run['verdict'] : [];
  $historical = is_array($successor['historical_verdict'] ?? NULL)
    ? $successor['historical_verdict']
    : [];
  $broken_at = is_numeric($verdict['broken_at'] ?? NULL)
    ? (int) $verdict['broken_at']
    : (is_numeric($historical['broken_at'] ?? NULL) ? (int) $historical['broken_at'] : NULL);
  $segment_id = is_string($successor['segment_id'] ?? NULL) && $successor['segment_id'] !== ''
    ? $successor['segment_id']
    : NULL;
  $placeholders = [
    '@broken_at' => $broken_at ?? (string) t('unknown'),
    '@segment_id' => $segment_id ?? (string) t('unknown'),
    '@historical_ok' => !empty($successor['historical_ok']) ? 'true' : 'false',
    '@segment_ok' => !empty($successor['segment_ok']) ? 'true' : 'false',
    '@time' => $when,
  ];
  return [
    'title' => $title,
    'value' => t('Documented historical exception at row @broken_at (last run @time)', $placeholders),
    'severity' => $severity,
    'description' => t('Audit Chain whole-history verification still reports the preserved failure at row @broken_at (historical_ok=@historical_ok). Successor segment @segment_id verifies independently (segment_ok=@segment_ok). This is a documented preserved failure, not a new break. Rows were not rewritten. A missing successor, or a successor that no longer verifies (segment_ok=false), is still a critical failure — investigate with <code>drush audit-chain:verify</code> and <code>drush audit-chain:recovery-verify</code>.', $placeholders),
  ];
}

/**
 * Add the append mutex without changing audit history.
 */
function audit_chain_update_10003(): string {
  $database = \Drupal::database();
  $schema = $database->schema();
  if (!$schema->tableExists('audit_chain_mutex')) {
    $schema->createTable('audit_chain_mutex', audit_chain_schema()['audit_chain_mutex']);
  }
  $database->merge('audit_chain_mutex')
    ->key('id', 1)
    ->fields(['locked' => 1])
    ->execute();
  return 'Added append serialization. Existing audit rows and seals are unchanged.';
}
