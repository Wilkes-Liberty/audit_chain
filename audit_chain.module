<?php

/**
 * @file
 * Audit Chain companion hooks.
 *
 * The module's services do the work; this file binds them to core's
 * scheduling and registers the reports dashboard theme. See
 * ScheduledVerifier for the scheduled-verification contract.
 */

declare(strict_types=1);

/**
 * Implements hook_help().
 */
function audit_chain_help(string $route_name): string {
  switch ($route_name) {
    case 'help.page.audit_chain':
      return '<p>' . t('Tamper-evident, hash-chained audit logging. Settings live at <a href=":settings">Configuration → System → Audit Chain</a>. Volume and integrity are at <a href=":reports">Reports → Audit Chain</a>.', [
        ':settings' => '/admin/config/system/audit-chain',
        ':reports' => '/admin/reports/audit-chain',
      ]) . '</p>';

    case 'audit_chain.dashboard':
      return '<p>' . t('Aggregates indexed chain columns only — metadata, IP addresses, user agents and entity labels are never shown. Charts use the Charts API when a library plugin is installed, otherwise an inline SVG fallback. The integrity card reads the last scheduled verification; it does not re-walk the chain.') . '</p>';
  }
  return '';
}

/**
 * Implements hook_theme().
 */
function audit_chain_theme(): array {
  return [
    'audit_chain_dashboard' => [
      'variables' => [
        'chain' => [],
        'tiles' => [],
        'charts' => [],
        'quick_actions' => [],
        'window' => '24h',
        'windows' => [],
      ],
    ],
  ];
}

/**
 * Implements hook_cron().
 *
 * Runs the scheduled keyed chain verification when it is due
 * (d.o #3616535). Disabled by default (`verify_interval: 0`); a due run
 * records its verdict in state, and a failure alerts through the
 * audit_chain logger channel and the verification-failed event without
 * ever rewriting the chain.
 *
 * Verification runs before the evidence export deliberately: the export is
 * gated on the last recorded verification verdict, so ordering them this way
 * means a failure discovered on this very cron run already blocks the push.
 */
function audit_chain_cron(): void {
  \Drupal::service('audit_chain.scheduled_verifier')->runIfDue();

  $config = \Drupal::config('audit_chain.settings');
  $destination = (string) $config->get('export_destination');
  if ($config->get('export_enabled') && $destination !== '') {
    $channel = (string) $config->get('export_channel');
    \Drupal::service('audit_chain.evidence_exporter')
      ->exportTo($destination, NULL, $channel === '' ? NULL : $channel);
  }
}
